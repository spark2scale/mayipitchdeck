rb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>messages</span></h2> <div class="et_pb_blurb_description"><p>sent to date<sup>2</sup></p></div> </div> </div> </div> </div><div class="et_pb_with_border et_pb_column_1_3 et_pb_column et_pb_column_56 p-m span-4 span-t-4 span-m-4 shift-t-3 shift-m-1  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_number_counter et_pb_number_counter_2 display-l-b  et_pb_text_align_center et_pb_bg_layout_light" data-number-value="53" data-number-separator=""> <div class="percent"><p><span class="percent-value"></span><span class="percent-sign"></span></p></div> </div><div class="et_pb_module et_pb_blurb et_pb_blurb_14 no-margin-p  et_pb_text_align_center  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>NPS score</span></h2> <div class="et_pb_blurb_description"><p>across 57k patient responses,<br>ranking “amazing”</p></div> </div> </div> </div> </div> </div> </div><div id="instructions" class="et_pb_section et_pb_section_32 space-2xl light-mode et_section_regular"> <div class="et_pb_row et_pb_row_39 ts-break-early rgap-2xl rgap-fix"> <div class="et_pb_column et_pb_column_1_2 et_pb_column_57 span-6 span-t-4 span-m-4 valign-middle order-2  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_code et_pb_code_33"> <div class="et_pb_code_inner"><div class="lottie-wrapper"> <lottie-player src="/wp-content/uploads/2026/03/CRP-14193-appointment-reminders.json" class="lottie" speed="1" mode="forward" renderer="svg"> </lottie-player> </div></div> </div><div class="et_pb_module et_pb_code et_pb_code_34 lzl" data-lzl-bg=""> </div> </div><div class="et_pb_column et_pb_column_1_2 et_pb_column_58 span-4 shift-8 shift-t-5 shift-m-1 valign-middle order-1 pb-s-ts  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_blurb et_pb_blurb_15 klara-text-pill body-m-b no-margin-b  et_pb_text_align_left  et_pb_blurb_position_left et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_main_blurb_image"><span class="et_pb_image_wrap"><span class="et-waypoint et_pb_animation_top et_pb_animation_top_tablet et_pb_animation_top_phone et-pb-icon et_pb_animation">󿀃</span></span></div> <div class="et_pb_blurb_container"> <div class="et_pb_blurb_description"><p>Patient Communication</p></div> </div> </div> </div><div class="et_pb_module et_pb_blurb et_pb_blurb_16 headline-l-h body-m-b  et_pb_text_align_left  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>Communicate with patients on their preferred channel</span></h2> <div class="et_pb_blurb_description"><p>Not all workflow automation tools were built like ModMed Patient Engagement.</p> <ul> <li>Automate patient appointment reminders without losing that personal feel</li> <li>Encourage no-shows to reschedule right from their phone</li> <li>Send personalized pre- and post-visit instructions and follow-ups</li> </ul></div> </div> </div> </div><div class="et_pb_button_module_wrapper et_pb_button_11_wrapper  et_pb_module"> <a class="et_pb_button et_pb_button_11 button-tertiary-large et_pb_bg_layout_light" href="https://www.modmed.com/what-we-do/patient-engagement/workflow-automation/" data-lzl-clk-nodef="*">Learn more</a> </div> </div> </div> </div><div class="et_pb_section et_pb_section_33 space-3xl light-mode et_section_regular"> <div class="et_pb_row et_pb_row_40 ts-break-early mb-2xl rgap-xs rgap-fix"> <div class="et_pb_column et_pb_column_1_3 et_pb_column_59 span-4 valign-middle order-1  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_code et_pb_code_35"> <div class="et_pb_code_inner"><div class="lottie-wrapper"> <lottie-player src="/wp-content/uploads/2026/03/crp-14195-Patient-easy-access.json" class="lottie" speed="1" mode="forward" renderer="svg" loop autoplay> </lottie-player> </div></div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_60 span-4 shift-5 shift-t-5 shift-m-1 valign-middle order-2  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_blurb et_pb_blurb_17 headline-l-h body-m-b no-margin-b  et_pb_text_align_left  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>No password, email, or app download required</span></h2> <div class="et_pb_blurb_description"><p>Make it easy for patients to reach your practice. Using ModMed Patient Engagement doesn’t require a password, email or app. Security is still top-of-mind though, with two-factor-authentication (2FA) available to every patient who wants it.</p></div> </div> </div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_61 kh-gradient-wrapper  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_image et_pb_image_16"> <span class="et_pb_image_wrap"><img decoding="async" src="data:image/svg+xml;base64," alt="Radial Gradient 1 Rose200" title="Radial Gradient 1 Rose200" class="wp-image-320099"></span> </div> </div> </div><div class="et_pb_row et_pb_row_41 ts-break-early mb-2xl rgap-xs rgap-fix"> <div class="et_pb_column et_pb_column_1_3 et_pb_column_62 span-4 shift-3 shift-t-1 shift-m-1 valign-middle order-2  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_blurb et_pb_blurb_18 headline-l-h body-m-b no-margin-b  et_pb_text_align_left  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>HIPAA-compliant practices: Meet secure patient messaging</span></h2> <div class="et_pb_blurb_description"><p>Send patient messages as standard texts or encrypted ones. For encrypted messages, we’ll include a link directing them to ModMed Patient Engagement to help you stay HIPAA-compliant and keep their information protected.</p></div> </div> </div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_63 span-4 shift-7 shift-t-5 shift-m-1 valign-middle order-1  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_code et_pb_code_36"> <div class="et_pb_code_inner"><div class="lottie-wrapper"> <lottie-player src="/wp-content/uploads/2026/03/crp-14195-Provider-secure-messaging.json" class="lottie" speed="1" mode="forward" renderer="svg" loop autoplay> </lottie-player> </div></div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_64 kh-gradient-wrapper  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_image et_pb_image_17"> <span class="et_pb_image_wrap"><img decoding="async" src="data:image/svg+xml;base64," alt="Radial Gradient 2 Blue50" title="Radial Gradient 2 Blue50" class="wp-image-320100"></span> </div> </div> </div><div class="et_pb_row et_pb_row_42 ts-break-early rgap-xs rgap-fix"> <div class="et_pb_column et_pb_column_1_3 et_pb_column_65 span-4 shift-5 shift-t-1 shift-m-1 valign-middle order-1  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_code et_pb_code_37"> <div class="et_pb_code_inner"><div class="lottie-wrapper"> <lottie-player src="/wp-content/uploads/2026/03/crp-14195-Patient-texting-night.json" class="lottie" speed="1" mode="forward" renderer="svg" loop autoplay> </lottie-player> </div></div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_66 span-4 shift-9 shift-t-5 shift-m-1 valign-middle order-2  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_blurb et_pb_blurb_19 headline-l-h body-m-b no-margin-b  et_pb_text_align_left  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>Patient text messages won’t interrupt movie night</span></h2> <div class="et_pb_blurb_description"><p>Give patients your textable practice number and don’t worry about your cell phone buzzing all night. Your messages will be waiting for you in ModMed Patient Engagement.</p></div> </div> </div> </div> </div><div class="et_pb_column et_pb_column_1_3 et_pb_column_67 kh-gradient-wrapper  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_image et_pb_image_18"> <span class="et_pb_image_wrap"><img decoding="async" src="data:image/svg+xml;base64," alt="Radial Gradient 3 Blue100" title="Radial Gradient 3 Blue100" class="wp-image-320101"></span> </div> </div> </div> </div><div class="et_pb_section et_pb_section_34 space-3xl light-mode et_section_regular"> <div class="et_pb_row et_pb_row_43 rspan-8 rspan-t-6 rspan-m-4 mb-xl"> <div class="et_pb_column et_pb_column_4_4 et_pb_column_68  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_text et_pb_text_45 headline-l-h  et_pb_text_align_left et_pb_bg_layout_light"> <div class="et_pb_text_inner"><h2>Why practice users love using ModMed Patient Engagement</h2></div> </div> </div> </div><div class="et_pb_row et_pb_row_44 rspan-8 rspan-t-6 rspan-m-4"> <div class="et_pb_column et_pb_column_4_4 et_pb_column_69 p-xs  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_image et_pb_image_19"> <span class="et_pb_image_wrap"><img decoding="async" width="160" height="160" src="data:image/png;base64," alt="Melanie Scott" title="Melanie Scott" srcset="/?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott.jpg&amp;n=T4OsyILc1mGvUMkM3uTvRw 160w, /?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott-150x150.jpg&amp;n=5ppwOZksJR4xFiQrqONQ 150w" sizes="(max-width: 160px) 100vw, 160px" class="wp-image-318300 lzl" data-lzl-srcset="/?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott.jpg&amp;n=T4OsyILc1mGvUMkM3uTvRw 160w, /?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott-150x150.jpg&amp;n=5ppwOZksJR4xFiQrqONQ 150w" data-lzl-src="/?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott.jpg&amp;n=T4OsyILc1mGvUMkM3uTvRw"><noscript lzl=""><img decoding="async" width="160" height="160" src="/?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott.jpg&amp;n=T4OsyILc1mGvUMkM3uTvRw" alt="Melanie Scott" title="Melanie Scott" srcset="/?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott.jpg&amp;n=T4OsyILc1mGvUMkM3uTvRw 160w, /?seraph_accel_gi=wp-content%2Fuploads%2F2026%2F03%2Fcrp-14195-Melanie-Scott-150x150.jpg&amp;n=5ppwOZksJR4xFiQrqONQ 150w" sizes="(max-width: 160px) 100vw, 160px" class="wp-image-318300"></noscript></span> </div><div class="et_pb_module et_pb_text et_pb_text_46  et_pb_text_align_left et_pb_bg_layout_light"> <div class="et_pb_text_inner"><blockquote> <p class="klara-quote-body">We have a unified system for appointment reminders and patient messaging. As a result, we’ve experienced a 15% reduction in call volume and no-shows.</p> <p><cite class="klara-quote-author"><strong>Melanie Scott</strong>, Director of Operations, Missoula, MT</cite> </p></blockquote></div> </div> </div> </div> </div><div class="et_pb_section et_pb_section_35 space-2xl light-mode et_pb_with_background et_section_regular"> <div class="et_pb_row et_pb_row_45 ts-break-early rgap-2xl rgap-fix"> <div class="et_pb_column et_pb_column_1_2 et_pb_column_70 span-5 span-t-4 span-m-4 valign-middle  et_pb_css_mix_blend_mode_passthrough"> <div class="et_pb_module et_pb_blurb et_pb_blurb_20 headline-m-h body-m-b no-margin-b mb-xl  et_pb_text_align_left  et_pb_blurb_position_top et_pb_bg_layout_light"> <div class="et_pb_blurb_content"> <div class="et_pb_blurb_container"> <h2 class="et_pb_module_header"><span>Ready to move beyond patient communication into active engagement?</span></h2> <div class="et_pb_blurb_description"><p>Discover how ModMed Patient Engagement can help by scheduling a personalized 30-minute demo using the button below.</p></div> </div> </div> </div><div class="et_pb_button_module_wrapper et_pb_button_12_wrapper  et_pb_module"> <a id="overlay_unique_id_275832" class="et_pb_button et_pb_button_12 button-primary-large et_pb_bg_layout_light" href="#Free-consultation" data-lzl-clk-nodef="*">Free consultation</a> </div> </div><div class="et_pb_column et_pb_column_1_2 et_pb_column_71 span-6 shift-7 span-t-4 shift-t-5 shift-m-1 span-m-4 valign-middle  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_code et_pb_code_38 full-width-img"> <div class="et_pb_code_inner"><div class="lottie-wrapper"> <lottie-player src="/wp-content/uploads/2026/03/Schedule-demo.json" class="lottie" speed="1" mode="forward" renderer="svg" loop autoplay> </lottie-player> </div> </div> </div> </div> </div> </div><div class="et_pb_section et_pb_section_36 footnote-container pv-l et_pb_with_background et_section_regular"> <div class="et_pb_row et_pb_row_46"> <div class="et_pb_column et_pb_column_4_4 et_pb_column_72  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_text et_pb_text_47 body-s-b no-margin-p  et_pb_text_align_left et_pb_bg_layout_dark"> <div class="et_pb_text_inner"><p>1 Klara utilization statistics based on internal benchmarking as of February 2025; Assistant Secretary for Technology Policy, <a href="https://healthit.gov/data/data-briefs/individuals-access-and-use-patient-portals-and-smartphone-health-apps-2022/">Individuals’ Access and Use of Patient Portals and Smartphone Health Apps</a> (2022).<br>
2 Klara utilization statistics based on internal benchmarking as of February 2025.</p></div> </div> </div> </div> </div> </div> </div> </div> </article> </div> <footer class="et-l et-l--footer"> <div class="et_builder_inner_content et_pb_gutters3"> <div class="et_pb_section et_pb_section_0_tb_footer footer-note et_pb_with_background et_section_regular"> <div class="et_pb_row et_pb_row_0_tb_footer"> <div class="et_pb_column et_pb_column_4_4 et_pb_column_0_tb_footer  et_pb_css_mix_blend_mode_passthrough et-last-child"> <div class="et_pb_module et_pb_text et_pb_text_0_tb_footer body-s-b  et_pb_text_align_left et_pb_bg_layout_dark"> <div class="et_pb_text_inner"><p>ModMed powers the AI-Powered Practice<sup>™</sup> for specialty physicians nationwide, helping them finish notes in less than an hour<sup>¶</sup>.</p> <p>¶ Results may vary based on practice size, product usage, and other factors. Time based on one ModMed Scribe user.</p></div> </div><div class="et_pb_module et_pb_code et_pb_code_0_tb_footer"> <div class="et_pb_code_inner"><script seraph-accel-crit="1">
  const footnote = document.querySelector('.footnote-container');
  const footer   = document.querySelector('.footer-note');
  
  if (footnote !== null) {
    console.log('fn: ', footnote, 'foot: ', footer);
    footnote.style.cssText = 'padding-bottom: 0 !important;';
    footer.style.cssText = 'padding-top: 0 !important';
  }
</script></div> </div> </div> </div> </div><div class="et_pb_section et_pb_section_1_tb_footer space-2xl et_pb_with_background et_section_regular et_pb_section--with-menu"> <div class="et_pb_row et_pb_row_1_tb_footer footer-menu-links mm-rowfix et_pb_row--with-menu"> <div class="et_pb_column et_pb_column_1_4 et_pb_column_1_tb_footer  et_pb_css_mix_blend_mode_passthrough et_pb_column--with-menu"> <div class="et_pb_with_border et_pb_module et_pb_text et_pb_text_1_tb_footer headline-s-b  et_pb_text_align_left et_pb_bg_layout_dark"> <div class="et_pb_text_inner"><p>Specialties</p></div> </div><div class="et_pb_module et_pb_menu et_pb_menu_0_tb_footer body-s-b et_pb_bg_layout_light  et_pb_text_align_left et_dropdown_animation_fade et_pb_menu--without-logo et_pb_menu--style-left_aligned"> <div class="et_pb_menu_inner_container clearfix"> <div class="et_pb_menu__wrap"> <div class="et_pb_menu__menu"> <nav class="et-menu-nav"><ul id="menu-specialties" class="et-menu nav"><li id="menu-item-262823" class="et_pb_menu_page_id-257968 menu-item menu-item-type-post_type menu-item-object-page menu-item-262823"><a href="https://www.modmed.com/specialties/allergy-immunology/">Allergy</a></li> <li id="menu-item-30536" class="et_pb_menu_page_id-30499 menu-item menu-item-type-post_type menu-item-object-page menu-item-30536"><a href="https://www.modmed.com/specialties/dermatology/">Dermatology</a></li> <li id="menu-item-30540" class="et_pb_menu_page_id-30503 menu-item menu-item-type-post_type menu-item-object-page menu-item-30540"><a href="https://www.modmed.com/specialties/ent/">ENT</a></li> <li id="menu-item-30537" class="et_pb_menu_page_id-30504 menu-item menu-item-type-post_type menu-item-object-page menu-item-30537"><a href="https://www.modmed.com/specialties/gastroenterology/">Gastroenterology</a></li> <li id="menu-item-262822" class="et_pb_menu_page_id-257993 menu-item menu-item-type-post_type menu-item-object-page menu-item-262822"><a href="https://www.modmed.com/specialties/obgyn